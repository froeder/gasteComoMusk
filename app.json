{
  "expo": {
    "name": "Gaste como Musk",
    "slug": "gaste-como-musk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gastecomomusk",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.froeder.gastecomomusk",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#050b18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050b18"
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "05fe52ca-9ee7-4bc7-bd22-2b3cbe5efbbb"
      },
      "firebaseApiKey": "",
      "firebaseAuthDomain": "",
      "firebaseProjectId": "",
      "firebaseStorageBucket": "",
      "firebaseMessagingSenderId": "",
      "firebaseAppId": "",
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "froeder"
  }
}
